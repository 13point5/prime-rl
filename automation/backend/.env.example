# Backend Configuration

# Database URL (SQLite by default, can use PostgreSQL/TimescaleDB)
DATABASE_URL=sqlite:///metrics.db
# For PostgreSQL: postgresql://user:password@localhost/metrics
# For TimescaleDB: postgresql://user:password@localhost/metrics

# API Key for securing endpoints (optional)
BACKEND_API_KEY=your-secret-key-here

# Server configuration
HOST=0.0.0.0
PORT=8080
